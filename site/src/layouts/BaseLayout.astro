---
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="sCau3n5L7D8vQmZBitK1HX4wZPiqeMQELDh9OguXDJg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        max-width: 880px;
        margin: 0 auto;
        padding: 2rem 1rem 4rem 1rem;
        line-height: 1.6;
        color: #0f172a;
        background-color: #f8fafc;
        /* Trama de cuadrícula digital + destellos sutiles de luz en esquinas */
        background-image: 
          radial-gradient(circle at 10% 20%, rgba(37, 99, 235, 0.08) 0%, transparent 40%),
          radial-gradient(circle at 90% 80%, rgba(124, 58, 237, 0.06) 0%, transparent 40%),
          linear-gradient(to right, rgba(203, 213, 225, 0.4) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(203, 213, 225, 0.4) 1px, transparent 1px);
        background-size: 100% 100%, 100% 100%, 32px 32px, 32px 32px;
        background-attachment: fixed;
      }
      a { color: #2563eb; text-decoration: none; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
