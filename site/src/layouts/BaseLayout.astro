---
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
<meta name="google-site-verification" content="sCau3n5L7D8vQmZBitK1HX4wZPiqueNQELDh9OguXDJg" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ?? 'Mi Web de Nichos'}</title>
    {description && <meta name="description" content={description} />}
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 780px;
        margin: 0 auto;
        padding: 2rem 1.25rem;
        line-height: 1.65;
        color: #1a1a1a;
        background: #fdfdfd;
      }
      a { color: #0a5cff; text-decoration: none; }
      a:hover { text-decoration: underline; }
      header { margin-bottom: 2.5rem; border-bottom: 1px solid #eee; padding-bottom: 1rem; }
      header a { font-size: 1.4rem; font-weight: 700; color: #1a1a1a; }
      .post-item { margin-bottom: 1.75rem; }
      .post-item h2 { margin-bottom: 0.25rem; }
      .post-date { color: #777; font-size: 0.9rem; }
      footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; color: #888; font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <header><a href="/">Mi Web de Nichos</a></header>
    <slot />
    <footer>Contenido generado automáticamente &mdash; actualizado cada 6 horas.</footer>
  </body>
</html>
