---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<BaseLayout title="Tech & Gadgets — Guías y Ofertas Recomendadas" description="Análisis objetivos y mejores ofertas en tecnología seleccionadas por expertos.">
  
  <!-- Banner Header con gráfico tecnológico incorporado -->
  <header style="text-align: center; padding: 3.5rem 1.5rem; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 20px; color: #ffffff; margin-bottom: 2.5rem; box-shadow: 0 12px 30px -5px rgba(15, 23, 42, 0.2); position: relative; overflow: hidden;">
    
    <!-- Gráfico SVG decorativo de fondo tipo matriz/tecnología -->
    <svg style="position: absolute; right: -20px; bottom: -20px; opacity: 0.12; width: 220px; height: 220px; pointer-events: none;" viewBox="0 0 100 100" fill="none" stroke="white" stroke-width="1.5">
      <path d="M10 10 H90 V90 H10 Z" />
      <path d="M30 30 H70 V70 H30 Z" />
      <circle cx="50" cy="50" r="10" />
      <line x1="10" y1="10" x2="30" y2="30" />
      <line x1="90" y1="10" x2="70" y2="30" />
      <line x1="90" y1="90" x2="70" y2="70" />
      <line x1="10" y1="90" x2="30" y2="70" />
    </svg>

    <span style="display: inline-flex; align-items: center; gap: 0.4rem; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); color: #38bdf8; padding: 0.35rem 0.9rem; border-radius: 9999px; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">
      ⚡ Guía de Compras & Chollos Top
    </span>
    
    <h1 style="font-size: 2.6rem; margin: 0 0 0.6rem 0; font-weight: 800; letter-spacing: -0.03em; color: #ffffff;">
      Tech & Gadgets
    </h1>
    
    <p style="color: #94a3b8; font-size: 1.05rem; margin: 0 auto; max-width: 520px; font-weight: 500; line-height: 1.5;">
      Analizamos y seleccionamos la mejor tecnología para que aciertes en tu compra al mejor precio.
    </p>
  </header>

  <!-- Lista de Artículos -->
  <main>
    <div style="display: grid; gap: 1.75rem;">
      {posts.map((post) => (
        <article style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.75rem; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03); display: flex; flex-direction: column; justify-content: space-between;">
          
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem;">
              <span style="background: #eff6ff; color: #2563eb; border: 1px solid #dbeafe; font-size: 0.73rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 8px; text-transform: uppercase; letter-spacing: 0.03em;">
                Análisis Recomendado
              </span>
              <time style="font-size: 0.8rem; color: #94a3b8; font-weight: 500;">
                {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            
            <h2 style="margin: 0.3rem 0 0.75rem 0; font-size: 1.4rem; font-weight: 800; line-height: 1.35;">
              <a href={`/posts/${post.slug}/`} style="color: #0f172a; text-decoration: none;">
                {post.data.title}
              </a>
            </h2>
            
            <p style="color: #475569; line-height: 1.6; margin-bottom: 1.5rem; font-size: 0.98rem;">
              {post.data.description}
            </p>
          </div>

          <div style="padding-top: 1.25rem; border-top: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
            <span style="color: #16a34a; font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem;">
              <span style="display: inline-block; width: 8px; height: 8px; background-color: #22c55e; border-radius: 50%;"></span>
              Disponible en Amazon
            </span>
            
            <a href={`/posts/${post.slug}/`} style="display: inline-flex; align-items: center; gap: 0.4rem; background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; font-weight: 700; font-size: 0.9rem; padding: 0.65rem 1.3rem; border-radius: 10px; text-decoration: none; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);">
              Ver análisis y oferta →
            </a>
          </div>

        </article>
      ))}
    </div>
  </main>

</BaseLayout>
